generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model clientes_fixos {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at           DateTime?            @default(now()) @db.Timestamptz(6)
  nome                 String
  email                String?
  valor_mensal         Decimal              @db.Decimal
  ativo                Boolean?             @default(true)
  dia_vencimento       Int?
  escopo_mensal        String?
  observacoes_internas String?
  data_inicio          DateTime?            @default(dbgenerated("CURRENT_DATE")) @db.Date
  data_cancelamento    DateTime?            @db.Date
  cnpj                 String?
  razao_social         String?
  telefone             String?
  tipo                 String               @default("cliente")
  portal_email         String?
  portal_senha_hash    String?
  portal_ativo         Boolean              @default(false)
  logo_url             String?
  documentos_cliente   documentos_cliente[]
  estrategias          estrategias[]
  metricas_mensais     metricas_mensais[]
  pagamentos           pagamentos[]
  propostas            propostas[]
  tickets              tickets[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model configuracoes {
  chave      String    @id
  valor      String
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model despesas {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  tipo                 String    @default("corporativa")
  descricao            String
  valor                Decimal   @db.Decimal(10, 2)
  mes                  Int
  ano                  Int
  pago                 Boolean?  @default(false)
  pago_em              DateTime? @db.Timestamptz(6)
  vencimento           DateTime? @db.Date
  recorrente           Boolean   @default(false)
  recorrencia_meses    Int?
  recorrencia_grupo_id String?   @db.Uuid

  @@index([recorrencia_grupo_id], map: "despesas_recorrencia_grupo_idx")
}

model documentos_cliente {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at      DateTime       @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at      DateTime       @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  cliente_fixo_id String         @db.Uuid
  titulo          String
  blocos          Json           @default("[]")
  visivel_portal  Boolean        @default(true)
  clientes_fixos  clientes_fixos @relation(fields: [cliente_fixo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([cliente_fixo_id], map: "documentos_cliente_cliente_fixo_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model estrategias {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at      DateTime        @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at      DateTime        @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  cliente_fixo_id String?         @db.Uuid
  titulo          String          @default("Nova Estratégia")
  descricao       String?
  nodes           Json            @default("[]")
  edges           Json            @default("[]")
  visivel_portal  Boolean         @default(false)
  clientes_fixos  clientes_fixos? @relation(fields: [cliente_fixo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([cliente_fixo_id], map: "estrategias_cliente_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model eventos {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  titulo     String
  descricao  String?
  start_at   DateTime  @db.Timestamptz(6)
  end_at     DateTime? @db.Timestamptz(6)
  all_day    Boolean?  @default(false)
  cor        String?   @default("slate")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model leads {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at     DateTime?   @default(now()) @db.Timestamptz(6)
  nome           String
  empresa        String?
  telefone       String?
  canal          String?     @default("pessoal")
  valor_estimado Decimal?    @db.Decimal(10, 2)
  anotacoes      String?
  status         String?     @default("contato")
  convertido_em  DateTime?   @db.Timestamptz(6)
  ticket_id      String?     @db.Uuid
  tickets        tickets?    @relation(fields: [ticket_id], references: [id], onUpdate: NoAction)
  propostas      propostas[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model metas {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mes         Int
  ano         Int
  meta_fixo   Decimal?  @default(0) @db.Decimal(10, 2)
  meta_avulso Decimal?  @default(0) @db.Decimal(10, 2)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([mes, ano])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model metricas_mensais {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at          DateTime?      @default(now()) @db.Timestamptz(6)
  cliente_fixo_id     String         @db.Uuid
  mes                 Int
  ano                 Int
  seguidores          Int?
  engajamento_percent Decimal?       @db.Decimal(5, 2)
  alcance             Int?
  visualizacoes       Int?
  extras              Json?          @default("{}")
  observacoes         String?
  clientes_fixos      clientes_fixos @relation(fields: [cliente_fixo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cliente_fixo_id, mes, ano])
  @@index([cliente_fixo_id, ano(sort: Desc), mes(sort: Desc)], map: "idx_metricas_cliente_periodo")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pagamentos {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  cliente_id     String?         @db.Uuid
  mes            Int
  ano            Int
  valor          Decimal         @db.Decimal
  recebido       Boolean?        @default(false)
  recebido_em    DateTime?       @db.Timestamptz(6)
  clientes_fixos clientes_fixos? @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cliente_id, mes, ano])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model parceiros {
  id                   String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at           DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at           DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  nome                 String
